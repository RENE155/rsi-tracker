# === RSI Tracker (backend / FastAPI) aplinkos kintamieji ===
# Nukopijuokite šį failą į `.env` ir įrašykite savo reikšmes.

# --- Privalomi ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
SUPABASE_URL=
# Backend prieigai naudokite SERVICE_ROLE raktą
SUPABASE_SERVICE_KEY=

# --- Nebūtini (numatytosios reikšmės) ---
# RSI_PERIODS=14
# OVERBOUGHT_THRESHOLD=90
# OVERSOLD_THRESHOLD=10
# KLINE_INTERVAL=240          # 60 (1H), 240 (4H), D (paros)
# ALERT_COOLDOWN_SECONDS=300  # 5 minutės
