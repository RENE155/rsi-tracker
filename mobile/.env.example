# === RSI Tracker (mobilioji programėlė) aplinkos kintamieji ===
# Nukopijuokite šį failą į `.env` ir įrašykite savo reikšmes.
# EXPO_PUBLIC_* kintamieji yra įkompiliuojami į programėlę – nelaikykite čia jautrių serverio raktų.

# Supabase (autentifikacija ir duomenų bazė)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (prenumeratos / pirkimai programėlėje)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Google prisijungimas
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLECLIENTSECRET=

# Bybit (rekomenduojama laikyti tik backend pusėje)
BYBIT_API_KEY=
BYBIT_API_SECRET=
